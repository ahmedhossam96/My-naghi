{
  "$defs": {
    "BrandOverride": {
      "additionalProperties": false,
      "properties": {
        "levels": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/Decision"
            },
            "propertyNames": {
              "$ref": "#/$defs/Classification"
            },
            "type": "object"
          },
          "default": {},
          "propertyNames": {
            "$ref": "#/$defs/Destination"
          },
          "title": "Levels",
          "type": "object"
        },
        "tags": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/Decision"
            },
            "propertyNames": {
              "$ref": "#/$defs/DataTag"
            },
            "type": "object"
          },
          "default": {},
          "propertyNames": {
            "$ref": "#/$defs/Destination"
          },
          "title": "Tags",
          "type": "object"
        },
        "workloads": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/Workload"
            },
            "type": "array",
            "uniqueItems": true
          },
          "default": {},
          "propertyNames": {
            "$ref": "#/$defs/Classification"
          },
          "title": "Workloads",
          "type": "object"
        }
      },
      "title": "BrandOverride",
      "type": "object"
    },
    "Classification": {
      "description": "Ordered sensitivity levels. Comparisons follow the order below.",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "title": "Classification",
      "type": "string"
    },
    "Control": {
      "description": "Controls a decision requires downstream components to apply.",
      "enum": [
        "approved_inference_only",
        "encrypt_at_rest",
        "no_persistence",
        "no_export",
        "no_telemetry_content",
        "redact_before_inference"
      ],
      "title": "Control",
      "type": "string"
    },
    "DataTag": {
      "description": "What kind of sensitive data was detected or declared.",
      "enum": [
        "national_id",
        "iban",
        "payment_card",
        "phone_number",
        "email_address",
        "vehicle_id",
        "credential",
        "customer_record",
        "voice_recording"
      ],
      "title": "DataTag",
      "type": "string"
    },
    "Decision": {
      "description": "Policy outcome, in increasing order of strictness.",
      "enum": [
        "allow",
        "redact",
        "restrict",
        "block"
      ],
      "title": "Decision",
      "type": "string"
    },
    "Destination": {
      "description": "Where data is about to go. Policies are evaluated per destination.",
      "enum": [
        "inference",
        "client_response",
        "persistence",
        "export",
        "backup"
      ],
      "title": "Destination",
      "type": "string"
    },
    "Workload": {
      "description": "What a token scope grants. Part of ``tenant:brand:workload``.",
      "enum": [
        "stt",
        "tts",
        "llm",
        "voice",
        "batch"
      ],
      "title": "Workload",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A versioned data-handling policy. One file per policy in ``config/policies``.",
  "properties": {
    "baseline": {
      "additionalProperties": {
        "$ref": "#/$defs/Classification"
      },
      "propertyNames": {
        "$ref": "#/$defs/Workload"
      },
      "title": "Baseline",
      "type": "object"
    },
    "brands": {
      "default": {},
      "patternProperties": {
        "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$": {
          "$ref": "#/$defs/BrandOverride"
        }
      },
      "title": "Brands",
      "type": "object"
    },
    "controls": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/Control"
        },
        "type": "array"
      },
      "default": {},
      "propertyNames": {
        "$ref": "#/$defs/Classification"
      },
      "title": "Controls",
      "type": "object"
    },
    "levels": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/Decision"
        },
        "propertyNames": {
          "$ref": "#/$defs/Classification"
        },
        "type": "object"
      },
      "propertyNames": {
        "$ref": "#/$defs/Destination"
      },
      "title": "Levels",
      "type": "object"
    },
    "owner": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Owner",
      "type": "string"
    },
    "policy_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$",
      "title": "Policy Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "tags": {
      "additionalProperties": {
        "additionalProperties": {
          "$ref": "#/$defs/Decision"
        },
        "propertyNames": {
          "$ref": "#/$defs/DataTag"
        },
        "type": "object"
      },
      "default": {},
      "propertyNames": {
        "$ref": "#/$defs/Destination"
      },
      "title": "Tags",
      "type": "object"
    },
    "version": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]{1,3}$",
      "title": "Version",
      "type": "string"
    },
    "workloads": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/Workload"
        },
        "type": "array",
        "uniqueItems": true
      },
      "default": {},
      "propertyNames": {
        "$ref": "#/$defs/Classification"
      },
      "title": "Workloads",
      "type": "object"
    }
  },
  "required": [
    "policy_id",
    "version",
    "owner",
    "baseline",
    "levels"
  ],
  "title": "HandlingPolicy",
  "type": "object"
}
