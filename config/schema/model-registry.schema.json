{
  "$defs": {
    "Artefact": {
      "additionalProperties": false,
      "properties": {
        "filename": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "filename",
        "sha256",
        "size_bytes"
      ],
      "title": "Artefact",
      "type": "object"
    },
    "DatasetEntry": {
      "additionalProperties": false,
      "properties": {
        "consent_basis": {
          "maxLength": 64,
          "title": "Consent Basis",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "languages": {
          "items": {
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Languages",
          "type": "array"
        },
        "license": {
          "anyOf": [
            {
              "$ref": "#/$defs/License"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "notes": {
          "default": "",
          "maxLength": 1000,
          "title": "Notes",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "evaluation",
            "fine_tuning"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "source_kind": {
          "$ref": "#/$defs/SourceKind"
        }
      },
      "required": [
        "id",
        "purpose",
        "consent_basis",
        "source_kind",
        "languages"
      ],
      "title": "DatasetEntry",
      "type": "object"
    },
    "License": {
      "additionalProperties": false,
      "properties": {
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/LicenseApproval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "notes": {
          "default": "",
          "maxLength": 500,
          "title": "Notes",
          "type": "string"
        },
        "spdx": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9.+-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spdx"
        },
        "url": {
          "anyOf": [
            {
              "pattern": "^https://\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "verified_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified On"
        }
      },
      "title": "License",
      "type": "object"
    },
    "LicenseApproval": {
      "additionalProperties": false,
      "description": "Recorded approval for a licence outside the SPDX allow-list.",
      "properties": {
        "approved_by": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Approved By",
          "type": "string"
        },
        "approved_on": {
          "format": "date",
          "title": "Approved On",
          "type": "string"
        },
        "license_text_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "License Text Sha256",
          "type": "string"
        },
        "license_url": {
          "pattern": "^https://\\S+$",
          "title": "License Url",
          "type": "string"
        }
      },
      "required": [
        "approved_by",
        "approved_on",
        "license_url",
        "license_text_sha256"
      ],
      "title": "LicenseApproval",
      "type": "object"
    },
    "ModelEntry": {
      "additionalProperties": false,
      "properties": {
        "artefacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Artefact"
          },
          "title": "Artefacts",
          "type": "array"
        },
        "format": {
          "const": "safetensors",
          "default": "safetensors",
          "title": "Format",
          "type": "string"
        },
        "hardware_profiles": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$",
            "type": "string"
          },
          "title": "Hardware Profiles",
          "type": "array"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "languages": {
          "items": {
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Languages",
          "type": "array"
        },
        "license": {
          "$ref": "#/$defs/License"
        },
        "notes": {
          "default": "",
          "maxLength": 1000,
          "title": "Notes",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "source": {
          "$ref": "#/$defs/Source",
          "default": {
            "repository": null,
            "revision": null
          }
        },
        "status": {
          "$ref": "#/$defs/Status",
          "default": "candidate"
        },
        "task": {
          "$ref": "#/$defs/Task"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "task",
        "version",
        "origin",
        "license",
        "languages"
      ],
      "title": "ModelEntry",
      "type": "object"
    },
    "Origin": {
      "additionalProperties": false,
      "properties": {
        "country": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        },
        "organization": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Organization",
          "type": "string"
        }
      },
      "required": [
        "organization"
      ],
      "title": "Origin",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository"
        },
        "revision": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        }
      },
      "title": "Source",
      "type": "object"
    },
    "SourceKind": {
      "enum": [
        "third_party_licensed",
        "public_licensed",
        "commissioned",
        "synthetic",
        "platform_traffic"
      ],
      "title": "SourceKind",
      "type": "string"
    },
    "Status": {
      "enum": [
        "candidate",
        "approved",
        "retired"
      ],
      "title": "Status",
      "type": "string"
    },
    "Task": {
      "enum": [
        "stt",
        "tts",
        "llm",
        "vad",
        "diarization"
      ],
      "title": "Task",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "datasets": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DatasetEntry"
      },
      "title": "Datasets",
      "type": "array"
    },
    "models": {
      "items": {
        "$ref": "#/$defs/ModelEntry"
      },
      "title": "Models",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "models"
  ],
  "title": "Registry",
  "type": "object"
}
