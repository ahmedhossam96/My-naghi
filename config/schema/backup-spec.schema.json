{
  "$defs": {
    "Source": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "include": {
          "default": [
            "*"
          ],
          "items": {
            "type": "string"
          },
          "title": "Include",
          "type": "array"
        },
        "optional": {
          "default": false,
          "title": "Optional",
          "type": "boolean"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "validate_as": {
          "default": "text",
          "enum": [
            "yaml",
            "json",
            "audit_jsonl",
            "text"
          ],
          "title": "Validate As",
          "type": "string"
        }
      },
      "required": [
        "id",
        "path"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "deny": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Deny",
      "type": "array"
    },
    "max_file_bytes": {
      "default": 5242880,
      "maximum": 67108864,
      "minimum": 1,
      "title": "Max File Bytes",
      "type": "integer"
    },
    "retention_days": {
      "default": 35,
      "maximum": 3650,
      "minimum": 1,
      "title": "Retention Days",
      "type": "integer"
    },
    "schema_version": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/Source"
      },
      "title": "Sources",
      "type": "array"
    },
    "spec_version": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]{1,3}$",
      "title": "Spec Version",
      "type": "string"
    }
  },
  "required": [
    "spec_version",
    "sources"
  ],
  "title": "BackupSpec",
  "type": "object"
}
